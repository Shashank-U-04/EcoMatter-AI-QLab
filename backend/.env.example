# Copy to .env and adjust. All values have working defaults for local demo.

# Use SQLite locally (default) or point at PostgreSQL:
# DATABASE_URL=postgresql+psycopg://ecomatter:ecomatter@localhost:5432/ecomatter
DATABASE_URL=sqlite:///./ecomatter.db

# CHANGE THIS in any shared/deployed environment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# Optional: enable IBM RXN for Chemistry retrosynthesis. Leave blank to use the
# local BRICS engine (no signup needed).
RXN_API_KEY=

# Genetic-algorithm tuning (defaults keep a run under ~90s).
GA_POPULATION_SIZE=60
GA_GENERATIONS=12
GA_MAX_CANDIDATES=30
GA_TIME_BUDGET_SECONDS=90

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
